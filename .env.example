# ── WALLET ──────────────────────────────────────────────────────────────────
# Your MetaMask private key (starts with 0x, 64 hex chars)
PRIVATE_KEY=

# Your Polymarket deposit wallet address (CLOB v2 — get it by running:
#   python -c "from api import PolymarketAPI; from config import Config; print(PolymarketAPI(Config()).get_deposit_wallet())"
# or from the Polymarket UI under Settings → API → Deposit Wallet)
DEPOSIT_WALLET_ADDRESS=

# Always 3 for CLOB v2 deposit wallet mode (POLY_1271)
SIGNATURE_TYPE=3

# ── MODE ────────────────────────────────────────────────────────────────────
# false = paper trading (logs would-be trades, no real orders)
# true  = REAL ORDERS WITH REAL MONEY
PRODUCTION=false

# How many shares per bet. Start at 2 until you've validated live with 100+ bets.
SHARES_PER_BET=2

# ── STRATEGY ────────────────────────────────────────────────────────────────
ACTIVE_STRATEGY=watch_120_bet_90

# Parameters for watch_120_bet_90
WATCH_SECOND=120        # When to check favourite price
BET_SECOND=90           # When to place the bet
PRICE_MIN=0.85          # Min favourite price at watch (inclusive)
PRICE_MAX=0.96          # Max favourite price at watch (exclusive)
BET_PRICE_MAX=0.98      # Skip if price at bet time is this high or higher

# ── APIs ────────────────────────────────────────────────────────────────────
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com
# Use publicnode — polygon-rpc.com is unreliable
RPC_URL=https://polygon-bor-rpc.publicnode.com

# ── TIMING ──────────────────────────────────────────────────────────────────
POLL_INTERVAL_MS=1000

# ── DASHBOARD ───────────────────────────────────────────────────────────────
DASHBOARD_PORT=8080
DASHBOARD_HOST=127.0.0.1

# ── PATHS ───────────────────────────────────────────────────────────────────
TRADES_CSV=data/trades.csv
LOG_FILE=logs/bot.log
